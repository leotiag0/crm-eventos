{
    "name": "crm-eventos-root",
    "version": "1.0.0",
    "description": "Sistema CRM Eventos - Root",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "build": "npm run build:frontend",
        "build:frontend": "cd frontend && npm install && npm run build",
        "install:all": "npm install && cd frontend && npm install",
        "postinstall": "npm install express http-proxy-middleware dotenv"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "http-proxy-middleware": "^3.0.3"
    }
}